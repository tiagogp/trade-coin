---
const { items = [] } = Astro.props as {
  items: { href: string; label: string }[];
};
---

<nav aria-label="Breadcrumb">
  <ol class="flex items-center space-x-2 text-sm text-zinc-400">
    {
      items.map((item, index) => (
        <li class="flex items-center">
          {index > 0 && <span class="mx-1 text-zinc-500">/</span>}
          {item.href ? (
            <a href={item.href} class="hover:underline text-zinc-200">
              {item.label}
            </a>
          ) : (
            <span class="text-zinc-400">{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
